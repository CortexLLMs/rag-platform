# ── Application ──────────────────────────────────────────────
APP_NAME="RAG Platform"
DEBUG=false

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=eyJ...

# ── Qdrant ───────────────────────────────────────────────────
# When running via Docker Compose, use the service name "qdrant" as hostname.
# For local (non-Docker) development, use http://localhost:6333 instead.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Production / Caddy ──────────────────────────────────────
# Set to your domain (e.g. api.yourdomain.com).
# Caddy will automatically provision a Let's Encrypt TLS certificate.
DOMAIN_NAME=api.yourdomain.com
